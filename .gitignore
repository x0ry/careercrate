# Python cache
__pycache__/
*.py[cod]
*.pyo

# Environment files
.env

# Virtual environments
venv/
env/

# IDE and editor files
.vscode/
.idea/
*.swp

# System files
.DS_Store
Thumbs.db

# Uploaded / generated data
uploads/
*.log
certs/

# Docker
mysql_data/
*.pid
*.sock

# Byte-compiled / build artifacts
build/
dist/
*.egg-info/

# Custom ignores
helper.txt
jobs_backup.sql
cheatsheet.md
backup.sql
refresh-local.bat
fetch_script.js
test.py
js/old_script.js

# Scraper output
scripts/output/

# Generated job export (scripts/export_jobs_md.py)
/job.md

# Test Files
scripts/tests/test_icims.py
scripts/tests/test_workday.py
scripts/tests/test_bamboohr.py
scripts/tests/test_enrich.py
scripts/tests/test_scraper.py

# Ignore JSON files globally, except specific tracked ones below
*.json
!data/chunks/jobs_manifest.json
!data/chunks/jobs_chunk_*.json.gz
!data/greenhouse_companies.json
!data/ashby_companies.json
!data/bamboohr_companies.json
!data/workday_companies.json
!data/lever_companies.json
!data/icims_companies.json
!data/paylocity_companies_clean.json
!data/locations.json
!data/salary/salary_lookup.json
!data/salary/shards/salary_*.json
!data/workable_companies.json
!data/smartrecruiters_companies.json
!data/recruitee_companies.json

# The Nashville-curated lists from a since-reverted approach - not deleted
# in case they're useful again, but nothing in scraper.py references them.
!data/nashville_*.json

# Keep trend history tracked on main (append-only, valuable, deltas cheaply)
!data/trends/
!data/trends/daily.jsonl

# Don't allow python files in data
data/*.py

# Ignore CSV files globally, except specific ones
/city_aggregator/*.csv
/city_aggregator/*.py
/city_aggregator/admin1CodesASCII.txt
/city_aggregator/cities500.txt